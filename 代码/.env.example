# 文脉 · 环境变量模板
# 复制为 .env 后填入自己的值：copy .env.example .env
# .env 已在 .gitignore 中排除，密钥绝不会进入仓库或提交包

# 百炼 API Key（在阿里云百炼控制台创建，建议使用 RAM 子账号并只授模型调用权限）
# 填好后**必须重启程序**（关掉命令行窗口，重新双击「启动文脉.bat」）才会生效：
# 本文件只在程序启动时读取一次，运行中修改不会热加载。
# Key 必须是纯英文数字；含中文或空格会被判为未填写，程序自动改用本地模型。
DASHSCOPE_API_KEY=

# 模型配置
#   想换模型：改下面 MODEL_DEFAULT 这一行（如 qwen-plus → qwen-max），改完必须重启程序。
#   注意：MODEL_CHEAP / MODEL_STRONG 是预留项，当前版本不生效（代码里未使用），改它们没有效果。
MODEL_DEFAULT=qwen-plus
MODEL_CHEAP=qwen-turbo
MODEL_STRONG=qwen-max

# 接口地址（百炼 OpenAI 兼容模式）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 成本护栏：单日花费上限（元），超过则拒绝调用
DAILY_COST_LIMIT_YUAN=20

# 是否启用结果缓存（开发期强烈建议开启，可省 30%–50% 调用费）
ENABLE_CACHE=true
